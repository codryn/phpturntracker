{
    "name": "codryn/phpturntracker",
    "description": "Flexible turn order tracking library for tabletop RPG combat systems",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "rpg",
        "tabletop",
        "turn-tracker",
        "initiative",
        "combat",
        "dnd",
        "shadowrun",
        "pathfinder",
        "game-master"
    ],
    "authors": [
        {
            "name": "Codryn",
            "email": "info@codryn.com"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "Codryn\\PhpTurnTracker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Codryn\\PhpTurnTracker\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "coverage": "phpunit --coverage-html coverage",
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "analyze": "phpstan analyse",
        "ci": [
            "@coverage",
            "@cs-check",
            "@analyze"
        ]
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
