{
    "name": "codryn/phpturntracker",
    "description": "Flexible turn order tracking library for tabletop RPG combat systems",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "rpg",
        "tabletop",
        "turn-tracker",
        "initiative",
        "combat",
        "dnd",
        "shadowrun",
        "pathfinder",
        "game-master"
    ],
    "authors": [
        {
            "name": "Codryn",
            "email": "info@codryn.com"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Codryn\\PHPTurnTracker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Codryn\\PHPTurnTracker\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-clover=coverage.xml",
        "test-coverage-html": "phpunit --coverage-html coverage/html",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "analyse": "phpstan analyse",
        "fix-line-endings"  : "bash scripts/fix-line-endings.sh",
        "verify-strict-types": "bash scripts/verify-strict-types.sh",
        "ci": [     
            "@fix-line-endings",
            "@test-coverage-html",
            "@cs-check",
            "@analyse",
            "@verify-strict-types"
        ]
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
