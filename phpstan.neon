parameters:
    level: 10
    paths:
        - src
    excludePaths:
        - tests
    tmpDir: build/phpstan
    reportUnmatchedIgnoredErrors: true
    ignoreErrors:
        # Allow array operations with mixed types for timeline config
        - '#Parameter \#1 \$slotConfiguration of class .* constructor expects .*#'
        # Allow iterable without value type for internal arrays
        - '#Property .* has no value type specified in iterable type array#'
        # Dead catch is acceptable for defensive programming
        - '#Dead catch - InvalidArgumentException is never thrown#'
